generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        Int       @id @default(autoincrement())
  name      String
  email     String    @unique
  password  String
  createdAt DateTime  @default(now())
  readings  Reading[]
}

model Reading {
  id        Int      @id @default(autoincrement())
  userId    Int
  date      DateTime @db.Date
  slot      Slot
  value     Int
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date, slot])
}

enum Slot {
  morning_fasting
  after_breakfast
  after_lunch
  after_dinner
}
